{
  "name": "ponder-bedrock",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build && npm run check && npm test && npm run typecheck",
    "pack": "npm run verify && node tools/pack.mjs",
    "font:measure": "node tools/measure-font.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.13.0-beta.1.26.70-preview.20",
    "@minecraft/server-ui": "2.4.0-beta.1.26.70-preview.20",
    "fflate": "0.8.2",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
