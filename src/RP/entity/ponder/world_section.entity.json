{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "ponder:world_section",
            "materials": {
                "default": "zombie"
            },
            "textures": {
                "default": "textures/special/ponder/blank"
            },
            "animations": {
                "place": "animation.ponder.world_section.place"
            },
            "scripts": {
                "initialize": [
                    "v.shown_at = -1;"
                ],
                "pre_animation": [
                    "v.shown_at = (v.shown_at < 0 && q.property('ponder:shown') > 0) ? q.life_time : v.shown_at;"
                ],
                "animate": [
                    "place"
                ],
                "should_update_bones_and_effects_offscreen": true
            },
            "geometry": {
                "default": "geometry.ponder.world_section"
            },
            "render_controllers": [
                "controller.render.zombie"
            ]
        }
    }
}
