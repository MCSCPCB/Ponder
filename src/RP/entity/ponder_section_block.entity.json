{
  "format_version": "1.26.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ponder:section_block",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/empty"
      },
      "geometry": {
        "default": "geometry.ponder.section_block"
      },
      "scripts": {
        "pre_animation": [
          "v.clock = (v.clock ?? 0) + q.delta_time;",
          "v.seen = v.seen ?? 0;",
          "v.fresh = (v.s ?? 0) != v.seen;",
          "v.fresh ? { v.seen = v.s; v.t0 = v.clock; };",
          "v.dur = math.max(v.dur ?? 0.0001, 0.0001);",
          "v.k = math.clamp((v.clock - (v.t0 ?? 0)) / v.dur, 0, 1);",
          "v.e = 1 - (1 - v.k) * (1 - v.k);",
          "v.fade = (v.dir ?? 1) > 0 ? v.e : 1 - v.e;",
          "v.mt = math.clamp((v.clock - (v.t0 ?? 0)) / math.max(v.mdur ?? 0.0001, 0.0001), 0, 1);",
          "v.lx = (v.ox ?? 0) + ((v.mx ?? 0) - (v.ox ?? 0)) * v.mt;",
          "v.ly = (v.oy ?? 0) + ((v.my ?? 0) - (v.oy ?? 0)) * v.mt;",
          "v.lz = (v.oz ?? 0) + ((v.mz ?? 0) - (v.oz ?? 0)) * v.mt;",
          "v.ax = (v.rx ?? 0) + ((v.sx ?? 0) - (v.rx ?? 0)) * v.mt;",
          "v.ay = (v.ry ?? 0) + ((v.sy ?? 0) - (v.ry ?? 0)) * v.mt;",
          "v.az = (v.rz ?? 0) + ((v.sz ?? 0) - (v.rz ?? 0)) * v.mt;"
        ],
        "animate": [
          "pose"
        ]
      },
      "animations": {
        "pose": "animation.ponder.section"
      },
      "render_controllers": [
        "controller.render.ponder.section_block"
      ],
      "held_item_scale": "(v.s ?? 0) > 0 ? 2.678 * math.max(v.fade ?? 1, 0.001) : 0.001"
    }
  }
}
