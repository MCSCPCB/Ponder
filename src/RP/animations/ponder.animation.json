            0
          ],
          "scale": [
            "q.property('ponder:g6')<0?0:(math.floor(math.max(0,q.property('ponder:g6'))/1048576)+1)/16",
            1,
            1
          ]
        },
        "glyph7": {
          "position": [
            "2*math.mod(q.property('ponder:p7'),512)",
            "-2*math.floor(q.property('ponder:p7')/512)",
            0
          ],
          "scale": [
            "q.property('ponder:g7')<0?0:(math.floor(math.max(0,q.property('ponder:g7'))/1048576)+1)/16",
            1,
            1
          ]
        }
      }
    },
    "animation.ponder.frame": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "q.camera_rotation(0) - q.body_x_rotation",
            "q.camera_rotation(1) - q.body_y_rotation",
            0
          ]
        },
        "fill": {
          "scale": [
            "q.property('ponder:width')",
            "q.property('ponder:height')",
            1
          ]
        },
        "top": {
          "position": [
            0,
            "q.property('ponder:height')*8",
            -0.12
          ],
          "scale": [
            "q.property('ponder:width')",
            0.025,
            1
          ]
        },
        "bottom": {
          "position": [
            0,
            "-q.property('ponder:height')*8",
            -0.12
          ],
          "scale": [
            "q.property('ponder:width')",
            0.025,
            1
          ]
        },
        "left": {
          "position": [
            "-q.property('ponder:width')*8",
            0,
            -0.12
          ],
          "scale": [
            0.025,
            "q.property('ponder:height')",
            1
          ]
        },
        "right": {
          "position": [
            "q.property('ponder:width')*8",
            0,
            -0.12
          ],
          "scale": [
            0.025,
            "q.property('ponder:height')",
            1
          ]
        }
      }
    },
    "animation.ponder.line": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "q.property('ponder:pitch')",
            "q.property('ponder:yaw')",
            0
          ]
        },
        "edge": {
          "scale": [
            "q.property('ponder:width')*1.8",
            "q.property('ponder:width')*1.8",
            "q.property('ponder:length')"
          ]
        },
        "core": {
          "scale": [
            "q.property('ponder:width')",
            "q.property('ponder:width')",
            "q.property('ponder:length')"
          ]
        }
      }
    },
    "animation.ponder.icon": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            "q.camera_rotation(0) - q.body_x_rotation",
            "q.camera_rotation(1) - q.body_y_rotation",
            0
          ]
        },
        "icon": {
          "rotation": [
            0,
            0,
            "q.property('ponder:angle')"
          ],
          "scale": "q.property('ponder:size')"
        }
      }
    },
    "animation.ponder.section": {
      "loop": true,
      "bones": {
        "root": {
          "position": [
            "((v.lx ?? 0) + (1 - (v.fade ?? 1)) * (v.dx ?? 0)) * 16",
            "((v.ly ?? 0) + (1 - (v.fade ?? 1)) * (v.dy ?? 0)) * 16",
            "-((v.lz ?? 0) + (1 - (v.fade ?? 1)) * (v.dz ?? 0)) * 16"
          ]
        },
        "center_in": {
          "position": [
            "(v.cx ?? 0) * 16",
            "(v.cy ?? 0) * 16",
            "-(v.cz ?? 0) * 16"
          ]
        },
        "spin_x": {
          "rotation": [
            "v.ax ?? 0",
            0,
            0
          ]
        },
        "spin_y": {
          "rotation": [
            0,
            "-(v.ay ?? 0)",
            0
          ]
        },
        "spin_z": {
          "rotation": [
            0,
            0,
            "-(v.az ?? 0)"
          ]
        },
        "center_out": {
          "position": [
            "-(v.cx ?? 0) * 16",
            "-(v.cy ?? 0) * 16",
            "(v.cz ?? 0) * 16"
          ]
        },
        "anchor_in": {
          "position": [
            "(v.tx ?? 0) * 16",
            "(v.ty ?? 0) * 16",
            "-(v.tz ?? 0) * 16"
          ]
        },
        "steady_x": {
          "rotation": [
            "-(v.ax ?? 0) * (v.steady ?? 0)",
            0,
            0
          ]
        },
        "steady_y": {
          "rotation": [
            0,
            "(v.ay ?? 0) * (v.steady ?? 0)",
            0
          ]
        },
        "steady_z": {
          "rotation": [
            0,
            0,
            "(v.az ?? 0) * (v.steady ?? 0)"
          ]
        },
        "anchor_out": {
          "position": [
            "-(v.tx ?? 0) * 16",
            "-(v.ty ?? 0) * 16",
            "(v.tz ?? 0) * 16"
          ]
        }
      }
    },
    "animation.ponder.sync": {
      "loop": true,
      "animation_length": 1,
      "bones": {
        "sync": {
          "scale": 1
        }
      }
    },
    "animation.ponder.section_item": {
      "loop": true,
      "bones": {
        "model": {
          "position": [
            -10.865,
            10.82,
            10.865
          ],
          "scale": 2.6663,
          "rotation": [
            -20,
            -45,
            0
          ]
        }
      }
    },
    "animation.ponder.section_grow": {
      "loop": true,
      "bones": {
        "root": {
          "scale": "(v.s ?? 0) > 0 ? math.max(v.fade ?? 1, 0.001) : 0.001"
        }
      }
    }
  }
}
