{
    "format_version": "1.8.0",
    "animations": {
        "animation.ponder.skybox.place": {
            "loop": true,
            "bones": {
                "root": {
                    "rotation": [
                        "-q.body_x_rotation",
                        "-q.body_y_rotation",
                        0
                    ]
                },
                "box": {
                    "scale": [
                        "q.property('ponder:size_x')",
                        "q.property('ponder:size_y')",
                        "q.property('ponder:size_z')"
                    ]
                }
            }
        }
    }
}
