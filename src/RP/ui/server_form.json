{
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "$screen_animations": [],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ],
    "force_render_below": true,
    "render_only_when_topmost": false,
    "render_game_behind": true,
    "load_screen_immediately": true
  },
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ponder_screen_factory": {
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@ponder.ponder_form_screen_layer"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}
