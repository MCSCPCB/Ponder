{
  "namespace": "server_form",
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "$additional_screen_content": "ponder.root",
    "$screen_bg_content": "ponder.compatible_background",
    "force_render_below": true,
    "render_game_behind": true,
    "load_screen_immediately": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },
  "main_screen_content": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (not ((#title_text - '§0§r§1§r') = #title_text)))",
        "target_property_name": "#visible"
      }
    ]
  },
  "main_screen_content/server_form_factory": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (not ((#title_text - '§0§r§1§r') = #title_text)))",
        "target_property_name": "#visible"
      }
    ]
  },
  "long_form": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (not ((#title_text - '§0§r§1§r') = #title_text)))",
        "target_property_name": "#visible"
      }
    ]
  },
  "custom_form": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (not ((#title_text - '§0§r§1§r') = #title_text)))",
        "target_property_name": "#visible"
      }
    ]
  }
}
