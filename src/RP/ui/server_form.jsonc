  /*注释
  // MIRROR_X, MIRROR_Y, MIRROR_Z, FOCUS_X, FOCUS_Y, FOCUS_Z, X, Y, Z are defined in presets.js
  "ponder_structure_renderer_XxYxZ": {
    "type": "input_panel",
    "size": [ "100%", "100%" ],
    "focus_enabled": true,
    "gesture_tracking_button": "button.turn_structure",
    "always_handle_controller_direction": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
