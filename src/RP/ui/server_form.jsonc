  /*注释
  // C is defined in progressPresets.js
  // i = 1 .. C
  "progress_anim_C_i": {
    "anim_type": "wait",
    "duration": 0,
    "next": "@server_form.progress_anim_C_i_motion"
  },

  "progress_anim_C_i_motion": {
    "anim_type": "size",
    "easing": "out_quart",
    "duration": 0.2,
    "from": [ WIDTH(i - 1), 3 ],
    "to": [ WIDTH(i), 3 ] // WIDTH(i) = round(224 * i / C)
  },

   // j = 1 .. C - 1
  "progress_anim_C_reverse_j": {
    "anim_type": "wait",
    "duration": 0,
    "next": "@server_form.progress_anim_C_reverse_j_motion"
  },

  "progress_anim_C_reverse_j_motion": {
    "anim_type": "size",
    "easing": "out_quart",
    "duration": 0.2,
    "from": [ WIDTH(j + 1), 3 ],
    "to": [ WIDTH(j), 3 ] // WIDTH(j) = round(224 * j / C)
  },
  */
  "preview_intro_offset": {
    "anim_type": "wait",
    "duration": 0.02,
    "next": "@server_form.preview_intro_offset_motion"
  },
  "preview_intro_offset_motion": {
    "anim_type": "offset",
    "easing": "out_quart",
    "duration": 0.48,
    "from": [
      0,
      -16
    ],
    "to": [
      0,
      -32
    ]
  },
  "preview_intro_alpha": {
    "anim_type": "wait",
    "duration": 0.02,
    "next": "@server_form.preview_intro_alpha_motion"
  },
  "preview_intro_alpha_motion": {
    "anim_type": "alpha",
    "easing": "out_quart",
    "duration": 0.48,
    "from": 0,
    "to": 1
  },
  "ponder_header_intro_alpha": {
    "anim_type": "alpha",
    "easing": "out_quart",
    "duration": 0.24,
    "from": 0,
    "to": 1
  },
  "ponder_header_intro_offset": {
    "anim_type": "offset",
    "easing": "out_quart",
    "duration": 0.24,
    "from": [
      21,
      24
    ],
    "to": [
      21,
      19
    ]
  },
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "$additional_screen_content": "server_form.ponder_form_additional_screen_content",
    "$screen_animations": [],
    "force_render_below": true,
    "render_only_when_topmost": false,
    "render_game_behind": true,
    "load_screen_immediately": true
  },
  "main_screen_content": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "main_screen_content/server_form_factory": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "long_form": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "custom_form": {
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "ponder_structure_renderer_window_base": {
    "$gesture_source_control|default": "structure_renderer_8",
    "$window_visibility_expression|default": "true",
    "$focus|default": [
      0,
      0,
      0
    ],
    "$bottom_left|default": [
      0,
      0,
      0
    ],
    "$top_right|default": [
      0,
      0,
      0
    ],
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [
      0,
      -32
    ],
    "size": [
      304,
      184
    ],
    "property_bag": {
      "#current_title_text": ""
    },
    "bindings": [
      {
        "binding_name": "#title_text",
        "binding_name_override": "#current_title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "$window_visibility_expression",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "renderer_body": {
          "type": "custom",
          "renderer": "3d_structure_renderer",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [
            "100%",
            "100%"
          ],
          "property_bag": {
            "#has_focus": false,
            "#block_position": "$focus",
            "#bottom_left_block": "$bottom_left",
            "#top_right_block": "$top_right",
            "#include_entities": false,
            "#remove_blocks": false,
            "#include_players": false
          },
          "bindings": [
            {
              "binding_name": "#has_focus",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#block_position",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#bottom_left_block",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#top_right_block",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#include_entities",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#remove_blocks",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#include_players",
              "binding_condition": "visible"
            },
            {
              "binding_type": "view",
              "source_control_name": "$gesture_source_control",
              "source_property_name": "#gesture_delta_source",
              "target_property_name": "#gesture_delta_source"
            },
            {
              "binding_type": "view",
              "source_control_name": "$gesture_source_control",
              "source_property_name": "#gesture_mouse_delta_x",
              "target_property_name": "#gesture_mouse_delta_x"
            },
            {
              "binding_type": "view",
              "source_control_name": "$gesture_source_control",
              "source_property_name": "#gesture_mouse_delta_y",
              "target_property_name": "#gesture_mouse_delta_y"
            }
          ]
        }
      }
    ]
  },
  "ponder_structure_renderer_window@server_form.ponder_structure_renderer_window_base": {},
  "ponder_structure_renderer_window_intro@server_form.ponder_structure_renderer_window_base": {
    "alpha": 0,
