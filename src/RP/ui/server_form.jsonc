          "$focus": [ MIRROR_X + FOCUS_X, MIRROR_Y + FOCUS_Y, MIRROR_Z + FOCUS_Z ],
          "$bottom_left": [ MIRROR_X, MIRROR_Y, MIRROR_Z ],
          "$top_right": [ MIRROR_X + X - 1, MIRROR_Y + Y - 1, MIRROR_Z + Z - 1 ],
          "$window_visibility_expression": "(not ((#current_title_text - '§8§r') = #current_title_text))"
        }
      }
    ]
  },
  */
