                "texture": "textures/ui/ponder/progress_keyframe"
              }
            }
          ]
        }
      }
      /*注释
      // C is defined in progressPresets.js
      // SIZE_MARKER is defined in presets.js
      {
        "keyframes_C": {
          "type": "panel",
          "layer": 3,
          "size": [
            "100%",
            "100%"
          ],
          "property_bag": {
            "#current_title_text": ""
          },
          "bindings": [
            {
              "binding_name": "#title_text",
              "binding_name_override": "#current_title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#current_title_text - 'SIZE_MARKER') = #current_title_text))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            // i = 1 .. C - 1
            {
              "marker_i": {
                "type": "image",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ MARKER_X(i), 2 ], // MARKER_X(i) = round(224 * i / C) + 1
                "size": [
                  2,
                  5
                ],
                "texture": "textures/ui/ponder/progress_keyframe"
              }
            }
          ]
        }
      }
      */
    ]
  },
