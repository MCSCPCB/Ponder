                                "source_property_name": "(not ((#bubble_text_raw - '§3§r§4§r') = ''))",
                                "target_property_name": "#visible"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  // SLOT_MARKERS are defined in constants.js
  "ponder_text_bubble_top@server_form.ponder_text_bubble_slot": {
    "$slot_visibility_expression": "(not ((#current_title_text - '§9§r§0§r') = #current_title_text))",
    "$slot_offset": [
