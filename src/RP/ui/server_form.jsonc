{
  // 只做挂载：原版表单定义一行不复制，只追加与按标题隐藏。Ponder 界面本体在 ui/ponder/ponder_ui.json。
  // TITLE_MARKER（§0§r§1§r）定义在 PonderConfig.js，两边必须同步。
  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    // 所有服务器表单共用这个屏幕，关掉进出场动画对原版表单同样生效（与 Simulated 相同）。
    "$screen_animations": [],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ],
    "force_render_below": true,
    "render_only_when_topmost": false,
    "render_game_behind": true,
    "load_screen_immediately": true
  },
  "main_screen_content": {
    "size": [
      "100%",
      "100%"
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            // 与原版同名的第二个 factory：每个 ActionFormData 会同时实例化原版 long_form 和 Ponder 界面。
            "ponder_screen_factory": {
              "type": "panel",
              "size": [
                "100%",
                "100%"
              ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@ponder.ponder_form_screen_layer"
                }
              }
            }
          }
        ]
      }
    ]
  },
  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_name": "#title_text"
          },
          {
            // 标题带 TITLE_MARKER 时隐藏原版表单，Ponder 界面绑相反的条件。
            "binding_type": "view",
            "source_property_name": "((#title_text - '§0§r§1§r') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  }
}
