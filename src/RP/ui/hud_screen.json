{
  "namespace": "hud",

  "hud_screen@common.base_screen": {
    "$screen_content": "hud.hud_content",
    "always_accepts_input": true,
    "force_render_below": true,
    "render_only_when_topmost": false,
    "should_steal_mouse": true,
    "$screen_animations": [],
    "$use_loading_bars": false
  },

  "hud_title_text/title_frame/title": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "view",
            "source_property_name": "((#text - 'pd:') = #text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "ponder_demo_structure_renderer": {
    "type": "input_panel",
    "size": [ "100%", "100%" ],
    "layer": 12,
    "focus_enabled": true,
    "gesture_tracking_button": "button.turn_structure",
    "always_handle_controller_direction": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.turn_structure",
        "mapping_type": "pressed",
        "button_up_right_of_first_refusal": true
      }
    ],
    "controls": [
      {
        "renderer": {
          "type": "custom",
          "renderer": "3d_structure_renderer",
          "layer": 12,
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ "155%", "155%" ],
          "property_bag": {
            "#has_focus": false,
            "#block_position": [ 3, 103, 3 ],
            "#bottom_left_block": [ 0, 100, 0 ],
            "#top_right_block": [ 7, 107, 7 ],
            "#include_entities": false,
            "#remove_blocks": false,
            "#include_players": false
          },
          "bindings": [
            {
              "binding_name": "#has_focus",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#block_position",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#bottom_left_block",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#top_right_block",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#include_entities",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#remove_blocks",
              "binding_condition": "visible"
            },
            {
              "binding_name": "#include_players",
              "binding_condition": "visible"
            },
            {
              "binding_type": "view",
              "source_control_name": "ponder_demo_structure_renderer",
              "source_property_name": "#gesture_delta_source",
              "target_property_name": "#gesture_delta_source"
            },
            {
              "binding_type": "view",
              "source_control_name": "ponder_demo_structure_renderer",
              "source_property_name": "#gesture_mouse_delta_x",
              "target_property_name": "#gesture_mouse_delta_x"
            },
            {
              "binding_type": "view",
              "source_control_name": "ponder_demo_structure_renderer",
              "source_property_name": "#gesture_mouse_delta_y",
              "target_property_name": "#gesture_mouse_delta_y"
            }
          ]
        }
      }
    ]
  },

  "ponder_demo_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "layer": 900,
    "controls": [
      {
        "ponder_state": {
          "type": "panel",
          "size": [ 0, 0 ],
          "property_bag": {
            "#state_text": ""
          },
          "bindings": [
            {
              "binding_name": "#hud_title_text_string",
              "binding_name_override": "#state_text",
              "binding_type": "global"
            }
          ]
        }
      },
      {
        "dimmer": {
          "type": "image",
          "size": [ "100%", "100%" ],
          "layer": 1,
          "texture": "textures/ui/White",
          "color": [ 0, 0, 0 ],
          "alpha": 0.55,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "ponder_state",
              "source_property_name": "((#state_text = 'pd:1') or (#state_text = 'pd:2') or (#state_text = 'pd:3'))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "demo_panel": {
          "type": "panel",
          "layer": 10,
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ 225, 200 ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "ponder_state",
              "source_property_name": "((#state_text = 'pd:1') or (#state_text = 'pd:2') or (#state_text = 'pd:3'))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "preview_frame": {
                "type": "panel",
                "layer": 10,
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 6 ],
                "size": [ 176, 176 ],
                "controls": [
                  {
                    "frame": {
                      "type": "image",
                      "layer": 2,
                      "size": [ "100%", "100%" ],
                      "texture": "textures/ui/greyBorder"
                    }
                  },
                  {
                    "fill": {
                      "type": "image",
                      "layer": 3,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 8px", "100% - 8px" ],
                      "texture": "textures/ui/White",
                      "color": [ 0.04, 0.05, 0.07 ],
                      "alpha": 0.94
                    }
                  },
                  {
                    "renderer_wrapper": {
                      "type": "panel",
                      "layer": 12,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 16px", "100% - 16px" ],
                      "controls": [
                        {
                          "renderer@hud.ponder_demo_structure_renderer": {}
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title_card": {
                "type": "image",
                "layer": 20,
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [ 0, 8 ],
                "size": [ 132, 20 ],
                "texture": "textures/ui/greyBorder",
                "controls": [
                  {
                    "title_label": {
                      "type": "label",
                      "layer": 21,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 12px", "default" ],
                      "text_alignment": "center",
                      "text": "PONDER DEMO",
                      "color": [ 1, 1, 1 ],
                      "shadow": false,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "rotation_hint": {
                "type": "image",
                "layer": 20,
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [ 0, -8 ],
                "size": [ 136, 18 ],
                "texture": "textures/ui/greyBorder",
                "controls": [
                  {
                    "hint_label": {
                      "type": "label",
                      "layer": 21,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 12px", "default" ],
                      "text_alignment": "center",
                      "text": "Drag to rotate",
                      "color": [ 0.9, 0.9, 0.9 ],
                      "shadow": false,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "bubble_step_1": {
                "type": "image",
                "layer": 30,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 6, 40 ],
                "size": [ 100, 40 ],
                "texture": "textures/ui/purpleBorder",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "ponder_state",
                    "source_property_name": "(#state_text = 'pd:1')",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "bubble_text": {
                      "type": "label",
                      "layer": 31,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 10px", "default" ],
                      "max_size": [ "100% - 10px", 32 ],
                      "text_alignment": "center",
                      "text": "Step 1\nRender stage.",
                      "color": [ 1, 1, 1 ],
                      "shadow": false,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "bubble_step_2": {
                "type": "image",
                "layer": 30,
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [ -6, 82 ],
                "size": [ 110, 40 ],
                "texture": "textures/ui/purpleBorder",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "ponder_state",
                    "source_property_name": "(#state_text = 'pd:2')",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "bubble_text": {
                      "type": "label",
                      "layer": 31,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 10px", "default" ],
                      "max_size": [ "100% - 10px", 32 ],
                      "text_alignment": "center",
                      "text": "Step 2\nRotate view.",
                      "color": [ 1, 1, 1 ],
                      "shadow": false,
                      "localize": false
                    }
                  }
                ]
              }
            },
            {
              "bubble_step_3": {
                "type": "image",
                "layer": 30,
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [ 0, -30 ],
                "size": [ 116, 40 ],
                "texture": "textures/ui/purpleBorder",
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "ponder_state",
                    "source_property_name": "(#state_text = 'pd:3')",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "bubble_text": {
                      "type": "label",
                      "layer": 31,
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "size": [ "100% - 10px", "default" ],
                      "max_size": [ "100% - 10px", 32 ],
                      "text_alignment": "center",
                      "text": "Step 3\nFinish angle.",
                      "color": [ 1, 1, 1 ],
                      "shadow": false,
                      "localize": false
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ponder_demo@hud.ponder_demo_root": {}
          }
        ]
      }
    ]
  }
}
