{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ponder:block_burst",
      "basic_render_parameters": {
        "material": "particles_opaque",
        "texture": "atlas.terrain"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.emitter_particles_count ?? 64"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1
      },
      "minecraft:emitter_shape_point": {
        "offset": ["Math.random(-0.5, 0.5)", "Math.random(-1, 0)", "Math.random(-0.5, 0.5)"],
        "direction": ["Math.random(-1, 1)", 1, "Math.random(-1, 1)"]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 / (Math.random(0, 1) * 0.9 + 0.1)"
      },
      "minecraft:particle_initial_speed": "Math.random(0, 4) * (variable.velocity_scalar ?? 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, -9.8, 0],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["variable.particle_random_1 * 0.0375 + 0.0375", "variable.particle_random_1 * 0.0375 + 0.0375"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            "variable.dig_particle_texture_coordinate.u + (variable.dig_particle_texture_size.u / 4) * (variable.particle_random_1 * 3)",
            "variable.dig_particle_texture_coordinate.v + (variable.dig_particle_texture_size.v / 4) * (variable.particle_random_2 * 3)"
          ],
          "uv_size": ["variable.dig_particle_texture_size.u / 4", "variable.dig_particle_texture_size.v / 4"]
        }
      },
      "minecraft:particle_motion_collision": {
        "collision_drag": 5,
        "coefficient_of_restitution": 0.1,
        "collision_radius": 0.1
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "Math.clamp(variable.dig_particle_color.r, 0, 1)",
          "Math.clamp(variable.dig_particle_color.g, 0, 1)",
          "Math.clamp(variable.dig_particle_color.b, 0, 1)",
          "Math.clamp(variable.dig_particle_color.a, 0, 1)"
        ]
      }
    }
  }
}
